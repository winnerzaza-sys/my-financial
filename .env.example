# Phase 1 uses IndexedDB. Enable only when cloud sync is ready.
VITE_ENABLE_CLOUD_SYNC=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave blank to use the built-in runtimes and model. Set false to disable Qwen.
VITE_ENABLE_QWEN=true
VITE_QWEN_RUNTIME=
VITE_QWEN_MODEL=
VITE_QWEN_REVISION=
VITE_OCR_RUNTIME=
VITE_OCR_WORKER=
VITE_OCR_CORE=
VITE_OCR_LANGUAGE=
